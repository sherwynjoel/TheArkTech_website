---
import { services } from "../data/services.ts";

const faqs = [
  {
    q: "How long does a project take?",
    a: "A simple landing page takes 1–2 weeks. A full website with CMS takes 3–5 weeks. A custom mobile app or software platform typically takes 8–14 weeks. We give you a firm timeline in your project scope document before we start.",
  },
  {
    q: "What is your pricing?",
    a: "Projects start at ₹25,000 for a basic website and go up based on scope. We provide fixed-price quotes — you'll never get a surprise invoice. Contact us and we'll give you an exact quote for your scope.",
  },
  {
    q: "Do you provide post-launch support?",
    a: "Yes. Every project includes a support period (1–3 months depending on plan). After that, we offer monthly maintenance packages covering updates, security patches, backups, and priority bug fixes.",
  },
  {
    q: "Can you redesign my existing website?",
    a: "Absolutely. We handle full rebuilds — modern architecture, improved performance, and cleaner, maintainable code. We migrate your existing content and data, preserve your URL structure so nothing breaks, and integrate the tools you already use.",
  },
  {
    q: "What technologies do you use?",
    a: "Our stack spans React, Next.js, Node.js, Python, Flutter, AWS, Docker, PostgreSQL, and MongoDB. We choose the right technology for your project's needs — not just what we're comfortable with — and we document why.",
  },
  {
    q: "Do you work with clients outside Coimbatore?",
    a: "Yes. We work with clients across India and internationally. All communication, handoffs, and reviews happen remotely via video calls, Notion, and staging environments. Location is no barrier.",
  },
  {
    q: "Can I see examples of your work?",
    a: "Yes — our Portfolio section above has live client sites you can visit right now, and Industries shows the verticals we've shipped for. For detailed case studies, reach out and we'll share work relevant to your industry.",
  },
  {
    q: "Who owns the code you write?",
    a: "You do. On final payment the full source code, repository access, and infrastructure accounts are transferred to you, along with technical documentation. We don't lock clients into proprietary platforms or hold credentials hostage.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<section id="faq" class="section-y">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="container-x">
    <div class="max-w-2xl mb-14 mx-auto text-center">
      <p class="eyebrow mb-3">FAQ</p>
      <h2 class="font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.05]">
        Questions we hear most
      </h2>
      <p class="mt-4 text-ink-muted">
        Can't find your answer? <a href="#contact" class="text-brand-bright hover:underline">Just ask us.</a>
      </p>
    </div>

    <div class="faq-list mx-auto" id="faq-list">
      {faqs.map((f, i) => (
        <div class="faq-item reveal" data-index={i}>
          {/* A real heading so screen-reader users can navigate the FAQ by heading. */}
          <h3 class="faq-h">
            <button class="faq-q" id={`faq-q-${i}`} aria-expanded="false" aria-controls={`faq-ans-${i}`}>
              <span>{f.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
          </h3>
          <div class="faq-a" id={`faq-ans-${i}`} role="region" aria-labelledby={`faq-q-${i}`} hidden>
            <div class="faq-a-inner"><p>{f.a}</p></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list { max-width: 52rem; }

  .faq-item {
    border-bottom: 1px solid var(--hairline);
  }
  .faq-item:first-child { border-top: 1px solid var(--hairline); }

  /* The heading is structural only — the button carries all the visual weight. */
  .faq-h { margin: 0; font-size: inherit; font-weight: inherit; letter-spacing: normal; }

  .faq-q {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    background: none;
    border: none;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition: color 0.2s;
  }
  .faq-q:hover { color: var(--brand-bright); }
  .faq-q[aria-expanded="true"] { color: var(--brand-bright); }

  .faq-icon {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 0.3s ease, border-color 0.2s;
  }
  .faq-q[aria-expanded="true"] .faq-icon {
    transform: rotate(45deg);
    border-color: var(--brand-bright);
  }

  /* grid-template-rows 0fr -> 1fr animates to the answer's natural height, so
     long answers can never be silently clipped the way a fixed max-height did. */
  .faq-a {
    display: grid;
    grid-template-rows: 0fr;
    /* visibility flips after the collapse finishes, so closed answers leave the
       accessibility tree despite the display:block below */
    visibility: hidden;
    transition:
      grid-template-rows var(--dur-3) var(--ease-out-quart),
      visibility 0s linear var(--dur-3);
  }
  .faq-a:not([hidden]) {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows var(--dur-3) var(--ease-out-quart);
  }
  .faq-a[hidden] { display: grid !important; }
  .faq-a-inner { overflow: hidden; min-height: 0; }

  .faq-a p {
    padding-bottom: 1.25rem;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--ink-muted);
    margin: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".faq-q").forEach((btn) => {
    btn.addEventListener("click", () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      const answerId = btn.getAttribute("aria-controls")!;
      const answerEl = document.getElementById(answerId)!;

      // Close all others
      document.querySelectorAll<HTMLButtonElement>(".faq-q").forEach((b) => {
        b.setAttribute("aria-expanded", "false");
        const id = b.getAttribute("aria-controls")!;
        const el = document.getElementById(id)!;
        el.hidden = true;
      });

      if (!expanded) {
        btn.setAttribute("aria-expanded", "true");
        answerEl.hidden = false;
      }
    });
  });
</script>
