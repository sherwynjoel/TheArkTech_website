---
import HeroScene from "./HeroScene.astro";

// Rotated by CSS animation alone — this used to be a React island (plus the
// whole React runtime) loaded client:load for a setInterval word swap.
const words = ["websites", "mobile apps", "custom software", "AI automation"];
const WORD_SECONDS = 2.2;

const particles = [
  { top: 8,  size: 2, dur: 30, delay: -2,  kind: "soft", op: 0.35 },
  { top: 16, size: 4, dur: 24, delay: -14, kind: "cyan", op: 0.5 },
  { top: 24, size: 3, dur: 38, delay: -8,  kind: "soft", op: 0.4 },
  { top: 33, size: 6, dur: 20, delay: -18, kind: "blue", op: 0.65 },
  { top: 42, size: 2, dur: 34, delay: -25, kind: "soft", op: 0.35 },
  { top: 50, size: 5, dur: 28, delay: -6,  kind: "cyan", op: 0.55 },
  { top: 58, size: 3, dur: 42, delay: -30, kind: "soft", op: 0.4 },
  { top: 67, size: 7, dur: 22, delay: -12, kind: "blue", op: 0.7 },
  { top: 75, size: 2, dur: 36, delay: -20, kind: "soft", op: 0.35 },
  { top: 84, size: 4, dur: 26, delay: -3,  kind: "cyan", op: 0.5 },
  { top: 92, size: 3, dur: 32, delay: -16, kind: "soft", op: 0.4 },
];

---

<section id="home" class="relative min-h-[100svh] flex items-center overflow-hidden pt-24 md:pt-32 pb-12 md:pb-16">
  <!-- animated ambient backdrop -->
  <div class="hero-bg pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="hero-blob hero-blob--1"></div>
    <div class="hero-blob hero-blob--2"></div>
    <div class="hero-glow"></div>
    {particles.map((p) => (
      <span
        class={`hero-particle hero-particle--${p.kind}`}
        style={`top:${p.top}%;--size:${p.size}px;--dur:${p.dur}s;--delay:${p.delay}s;--op:${p.op}`}
      ></span>
    ))}
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-black"></div>
  </div>

  <div class="container-x grid lg:grid-cols-12 gap-12 items-center">

    <!-- ── LEFT: copy ── -->
    <div class="lg:col-span-7">
      <!-- live badge -->
      <div class="hero-live-badge mb-6">
        <span class="hero-live-dot" aria-hidden="true"></span>
        Available for new projects
      </div>

      <p class="eyebrow mb-4">Software Development Company · Coimbatore, India</p>
      <h1 class="font-display font-bold leading-[1.1] text-[clamp(2.4rem,5vw,4.5rem)]">
        We build<br />
        <span class="flip" style={`--count:${words.length};--word-s:${WORD_SECONDS}s`}>
          {/* All words share one grid cell, so the line reserves the tallest
              word's height and nothing can overflow or shift. */}
          {words.map((w, i) => (
            <span class="flip-word" style={`--i:${i}`}>{w}</span>
          ))}
          <span class="sr-only">{words.join(", ")}</span>
        </span><br />
        that ship.
      </h1>
      <p class="mt-6 max-w-lg text-lg text-ink-muted leading-relaxed">
        TheArkTech engineers web and mobile applications, custom software,
        cloud infrastructure, and AI automation — owned end to end, from
        architecture through deployment and support.
      </p>

      <div class="mt-7 md:mt-9 flex flex-col sm:flex-row flex-wrap sm:items-center gap-4">
        <a href="#contact" class="shiny-btn">
          <span>Start a project</span>
        </a>
        <a href="#services" class="btn-glass w-full sm:w-auto text-center">Explore services</a>
      </div>

      <!-- social proof row -->
      <div class="hero-proof mt-10">
        <div class="hero-proof-text">
          <div class="hero-stars" aria-label="5 star rating">★★★★★</div>
          <p><strong>10</strong> client projects delivered across India</p>
        </div>
      </div>
    </div>

    <!-- ── RIGHT: the laptop — poster for everyone, WebGL scene where allowed ── -->
    <div class="lg:col-span-5 relative hero-visual">
      <HeroScene />
    </div>
  </div>
</section>

<style>
  /* ── backdrop ── */
  .hero-bg { overflow: hidden; }
  .hero-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(115% 90% at 28% 22%, #000 0%, transparent 72%);
    mask-image: radial-gradient(115% 90% at 28% 22%, #000 0%, transparent 72%);
  }
  .hero-blob { position: absolute; border-radius: 9999px; filter: blur(72px); will-change: transform; }
  .hero-blob--1 { top:-10rem; left:-8rem; height:36rem; width:36rem; opacity:.45;
    background: radial-gradient(circle, var(--brand-deep), transparent 60%);
    animation: hero-drift-1 26s ease-in-out infinite alternate; }
  .hero-blob--2 { top:26%; right:-8rem; height:34rem; width:34rem; opacity:.3;
    background: radial-gradient(circle, var(--brand), transparent 60%);
    animation: hero-drift-2 32s ease-in-out infinite alternate; }
  .hero-glow {
    position: absolute; top:-18%; left:8%; height:40rem; width:40rem;
    background: radial-gradient(circle, rgba(34,211,238,0.1), transparent 62%);
    filter: blur(40px); will-change: transform, opacity;
    animation: hero-sweep 22s ease-in-out infinite alternate; }
  .hero-particle { position: absolute; left:0; width:var(--size); height:var(--size);
    border-radius:9999px; opacity:0; box-shadow:0 0 calc(var(--size)*1.5) rgba(96,165,250,0.25);
    animation: hero-cross var(--dur) linear var(--delay) infinite; will-change: transform; }
  .hero-particle--soft { background: rgba(226,234,252,0.85); }
  .hero-particle--blue { background: var(--brand-bright); }
  .hero-particle--cyan { background: var(--accent-cyan); }

  @keyframes hero-drift-1 { from { transform: translate(0,0) scale(1); } to { transform: translate(42px,30px) scale(1.08); } }
  @keyframes hero-drift-2 { from { transform: translate(0,0) scale(1); } to { transform: translate(-50px,-26px) scale(1.12); } }
  @keyframes hero-sweep   { from { transform: translate(-6%,-4%); opacity:.65; } to { transform: translate(20%,12%); opacity:1; } }
  @keyframes hero-cross {
    0%   { transform: translateX(-6vw); opacity: 0; }
    10%  { opacity: var(--op); }
    90%  { opacity: var(--op); }
    100% { transform: translateX(106vw); opacity: 0; }
  }

  /* ── live badge ── */
  .hero-live-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.35rem 0.85rem; border-radius: 9999px;
    background: rgba(34,211,238,0.08); border: 1px solid rgba(34,211,238,0.25);
    font-size: 0.78rem; color: var(--accent-cyan); font-weight: 500;
  }
  .hero-live-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 6px var(--accent-cyan);
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%,100% { opacity: 1; transform: scale(1); }
    50%     { opacity: 0.5; transform: scale(1.4); }
  }

  /* ── rotating word ── */
  .flip {
    display: inline-grid;
    vertical-align: top;
    text-align: left;
  }
  .flip-word {
    grid-area: 1 / 1;
    color: var(--brand-bright);
    opacity: 0;
    /* From md up the column is wide enough for the longest word, so keep it on
       one line — otherwise the grid reserves two line-heights for every word and
       leaves a visible gap above "that ship." Below md we allow wrapping, since
       the stack absorbs it and clipping the headline would be worse. */
    white-space: nowrap;
    will-change: opacity, transform;
    animation: flip-word calc(var(--count) * var(--word-s)) var(--ease-out-quart) infinite;
    animation-delay: calc(var(--i) * var(--word-s));
  }
  /* Visible for one slot of the cycle, then handed to the next word.
     25% = one slot of four; the fades sit inside it so they never overlap. */
  @keyframes flip-word {
    0%   { opacity: 0; transform: translateY(0.4em); }
    3%   { opacity: 1; transform: translateY(0); }
    22%  { opacity: 1; transform: translateY(0); }
    25%  { opacity: 0; transform: translateY(-0.4em); }
    100% { opacity: 0; transform: translateY(-0.4em); }
  }

  @media (max-width: 767px) {
    .flip-word { white-space: normal; }
  }

  /* ── primary hero CTA (was a React island for a hover sheen) ── */
  .shiny-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 2rem;
    border-radius: 9999px;
    font-weight: 600;
    color: #fff;
    overflow: hidden;
    border: 1px solid rgba(96, 165, 250, 0.5);
    background: linear-gradient(120deg, var(--brand-deep), var(--brand-strong));
    box-shadow: 0 6px 24px rgba(59, 130, 246, 0.3);
    transition: transform var(--dur-2) var(--ease-out-quart), box-shadow var(--dur-2) var(--ease-out-quart);
  }
  .shiny-btn > span { position: relative; z-index: 2; }
  .shiny-btn::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,0.55) 50%, transparent 70%);
    transform: translateX(-120%);
    transition: transform 0.9s var(--ease-out-quart);
  }
  .shiny-btn:hover,
  .shiny-btn:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 10px 40px rgba(59, 130, 246, 0.45);
  }
  .shiny-btn:hover::after,
  .shiny-btn:focus-visible::after { transform: translateX(120%); }

  /* ── social proof ── */
  .hero-proof { display: flex; align-items: center; gap: 1rem; }
  .hero-proof-text p { font-size: 0.85rem; color: var(--ink-muted); margin: 0; }
  .hero-proof-text strong { color: var(--ink); }
  .hero-stars { color: #facc15; font-size: 0.8rem; letter-spacing: 1px; margin-bottom: 2px; }

  /* ── right visual: product illustration ── */
  .hero-visual { position: relative; }

  /* Two motion systems in one viewport compete; the scene wins while it is live. */
  #home.is-live .hero-particle { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .hero-blob, .hero-glow { animation: none; }
    .hero-particle { display: none; }
    .hero-live-dot { animation: none; }
    /* Settle on the first word rather than cycling — without this the global
       reduced-motion rule would collapse the cycle and leave every word at
       its end state (invisible). */
    .flip-word { animation: none; opacity: 0; }
    .flip-word:first-child { opacity: 1; }
  }
</style>
