---
/**
 * Floating "Call us" button, bottom-right on every page. The button itself is
 * the 21st.dev liquid-glass button (CallFab.tsx, a React island); this wrapper
 * owns the fixed positioning and steps aside while the contact form is on
 * screen. The `dark` class turns on the component's glass highlights, which
 * are written for dark backgrounds behind Tailwind's dark variant.
 */
import CallFabButton from "./CallFab.tsx";
import { PHONE_E164, PHONE_LABEL } from "../data/site";
---
<div class="call-fab dark z-50">
  <CallFabButton client:load tel={PHONE_E164} label={PHONE_LABEL} />
</div>

<style>
  .call-fab {
    position: fixed;
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    right: 1rem;
    transition: opacity var(--dur-2) var(--ease-out-quart), transform var(--dur-2) var(--ease-out-quart);
  }
  /* The glass component rounds its shadow layer but not its refraction layer;
     match the pill shape so the corners agree. */
  .call-fab :global([style*="container-glass"]) { border-radius: 9999px; }
  /* The contact form's inline errors and submit button sit bottom-right; a
     permanently pinned FAB covers them. Step aside while contact is on screen. */
  .call-fab.is-hidden {
    opacity: 0;
    transform: translateY(150%);
    pointer-events: none;
  }
</style>

<script>
  const fab = document.querySelector<HTMLElement>(".call-fab");
  const contact = document.getElementById("contact");

  if (fab && contact && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      ([entry]) => fab.classList.toggle("is-hidden", entry.isIntersecting),
      { threshold: 0.12 }
    );
    io.observe(contact);
  }
</script>
