---
// Root-relative hrefs so these work from /contact, /terms and /privacy too —
// a bare "#contact" is a dead link on every page except the homepage.
// `spy` keeps the scroll-spy matching against the homepage section ids.
import NavRoll from "./NavRoll.tsx";
import NavRollMobile from "./NavRollMobile.tsx";
import { PHONE_E164, PHONE_LABEL, EMAIL } from "../data/site";

const links = [
  { href: "/#services", spy: "#services", label: "Services" },
  { href: "/about", spy: "#why", label: "About" },
  { href: "/contact", spy: "#contact", label: "Contact" },
];
---
<header id="site-nav" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
  <div class="container-x flex items-center justify-between py-3">
    <a href="#home" class="flex items-center gap-3">
      <img src="/logo.png" alt="TheArkTech logo" width="48" height="40" class="h-10 w-12 object-contain" />
      <span class="font-display text-xl font-bold tracking-tight">TheArkTech</span>
    </a>
    <nav class="hidden md:flex items-center gap-1 glass glass-blur rounded-full px-2 py-1">
      {links.map((l) => (
        <a href={l.href} data-nav={l.spy} aria-label={l.label} class="nav-link inline-flex px-4 py-2 rounded-full text-sm font-medium text-ink-muted hover:text-ink hover:bg-white/10 transition">
          <NavRoll client:idle text={l.label} />
        </a>
      ))}
    </nav>
    <a href="/#contact" class="hidden md:inline-flex btn-glass text-sm py-2 px-5">Get Quote</a>
    <button id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-mobile" class="md:hidden glass glass-blur rounded-xl p-3 min-w-[44px] min-h-[44px] flex items-center justify-center">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
  <div id="nav-mobile" class="md:hidden hidden nav-sheet">
    <nav class="container-x nav-sheet-inner" aria-label="Site">
      <ul class="nav-sheet-links">
        {links.map((l, i) => (
          <li>
            <a href={l.href} data-nav={l.spy} aria-label={l.label} class="nav-link nav-sheet-link">
              <NavRollMobile client:visible text={l.label} index={i} />
            </a>
          </li>
        ))}
      </ul>
      <a href="/#contact" class="btn-primary nav-sheet-cta">Get a quote</a>
      <div class="nav-sheet-contact">
        <a href={`tel:${PHONE_E164}`} class="nav-sheet-phone">{PHONE_LABEL}</a>
        <a href={`mailto:${EMAIL}`} class="nav-sheet-mail">{EMAIL}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const nav = document.getElementById("site-nav");
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 24) nav.classList.add("nav-scrolled");
    else nav.classList.remove("nav-scrolled");
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-mobile");

  function setMenu(open: boolean, returnFocus = false) {
    if (!menu || !toggle) return;
    menu.classList.toggle("hidden", !open);
    nav?.classList.toggle("nav-open", open);
    document.body.style.overflow = open ? "hidden" : "";
    document.body.classList.toggle("menu-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    if (open) {
      menu.querySelector<HTMLAnchorElement>("a")?.focus();
    } else if (returnFocus) {
      toggle.focus();
    }
  }

  toggle?.addEventListener("click", () => setMenu(menu?.classList.contains("hidden") ?? false));

  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setMenu(false))
  );

  // Escape closes and hands focus back to the button that opened it.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || menu?.classList.contains("hidden")) return;
    setMenu(false, true);
  });

  // Keep Tab inside the open menu — otherwise focus walks the page behind it.
  menu?.addEventListener("keydown", (e) => {
    if (e.key !== "Tab" || !toggle) return;
    const focusables = [toggle, ...Array.from(menu.querySelectorAll<HTMLElement>("a"))];
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Scroll-spy: reflect the section in view on the nav links (desktop + mobile share hrefs).
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link"));
  const watched = ["services", "industries", "portfolio", "contact"]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el);
  if (navLinks.length && watched.length) {
    const setCurrent = (id: string | null) => {
      navLinks.forEach((l) =>
        l.classList.toggle("is-current", !!id && l.dataset.nav === `#${id}`)
      );
    };
    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) setCurrent(visible.target.id);
      },
      { rootMargin: "-45% 0px -50% 0px", threshold: [0, 0.25, 0.5] }
    );
    watched.forEach((el) => spy.observe(el));
  }
</script>

<style>
  #site-nav { transition: background var(--dur-2) var(--ease-out-quart), border-color var(--dur-2) var(--ease-out-quart); }
  #site-nav.nav-scrolled { background: rgba(0,0,0,0.55); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--hairline); }

  /* Active section — a quiet, persistent highlight (not a shouty pill). */
  .nav-link.is-current { color: var(--ink); background: rgba(96, 165, 250, 0.14); }
  #nav-mobile .nav-link.is-current { color: var(--brand-bright); }

  /* Mobile menu: a full-screen sheet behind the header bar (z-index -1 keeps
     the logo and the close button on top inside the header's own stacking context). */
  #site-nav.nav-open { background: #000; }
  :global(body.menu-open .call-fab) { display: none; }
  .nav-sheet {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: #000;
    overflow-y: auto;
    padding-top: 5.25rem;
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
  }
  .nav-sheet-inner { min-height: 100%; display: flex; flex-direction: column; }
  .nav-sheet-links { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .nav-sheet-link {
    display: block;
    padding: 0.5rem 0;
    font-family: "Clash Display", sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 9vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .nav-sheet-cta {
    margin-top: 2rem;
    width: 100%;
    justify-content: center;
    padding: 1.05rem 1.5rem;
    border-radius: 9999px;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .nav-sheet-contact {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .nav-sheet-phone { font-family: "Clash Display", sans-serif; font-weight: 700; font-size: 1.45rem; color: var(--brand-bright); }
  .nav-sheet-mail { color: var(--ink-faint); font-size: 1rem; overflow-wrap: anywhere; }
</style>

