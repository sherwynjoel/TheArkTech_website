---
import WarpShaderBackground from "@/components/ui/wrap-shader.tsx";
import { EMAIL } from "../data/site";

interface Props {
  /** Small label above the heading; the contact page overrides it. */
  eyebrow?: string;
  heading?: string;
}
const { eyebrow = "Contact", heading = "Let's build it together" } = Astro.props;
---
<section id="contact" class="relative section-y-lg overflow-hidden">
  <div class="absolute inset-0 -z-10" style="background: linear-gradient(135deg, var(--brand-deep), #04060d 70%);">
    <WarpShaderBackground client:visible />
    <div class="absolute inset-0 bg-black/50"></div>
  </div>

  <div class="container-x">
    <div class="max-w-xl mx-auto text-center mb-10">
      <p class="eyebrow mb-3">{eyebrow}</p>
      <h2 class="font-display text-[clamp(2rem,4vw,3.25rem)]">{heading}</h2>
      <p class="mt-3 text-ink-muted">Fill in your details and we'll open WhatsApp with a pre-typed message — reply whenever you're ready.</p>
    </div>

    <form id="contact-form" class="contact-card max-w-xl mx-auto rounded-3xl p-4 sm:p-8" novalidate>
      <p class="cf-note">All fields are required.</p>
      <div class="cf-field">
        <label for="cf-name" class="cf-label">Name</label>
        <input id="cf-name" name="name" type="text" required minlength="2" autocomplete="name"
          aria-describedby="cf-name-err"
          class="cf-input w-full rounded-xl bg-white/5 border border-white/15 px-4 py-3.5 text-ink placeholder-ink-faint focus:border-brand focus:ring-2 focus:ring-[var(--ring)] outline-none transition" />
        <p id="cf-name-err" class="cf-field-err" aria-live="polite"></p>
      </div>

      <div class="cf-field">
        <label for="cf-email" class="cf-label">Email</label>
        <input id="cf-email" name="email" type="email" placeholder="you@example.com" required autocomplete="email"
          aria-describedby="cf-email-err"
          class="cf-input w-full rounded-xl bg-white/5 border border-white/15 px-4 py-3.5 text-ink placeholder-ink-faint focus:border-brand focus:ring-2 focus:ring-[var(--ring)] outline-none transition" />
        <p id="cf-email-err" class="cf-field-err" aria-live="polite"></p>
      </div>

      <div class="cf-field">
        <label for="cf-phone" class="cf-label">Phone</label>
        <input id="cf-phone" name="phone" type="tel" placeholder="+91 98765 43210" required autocomplete="tel"
          pattern="[0-9+()\s-]{7,}" aria-describedby="cf-phone-err"
          class="cf-input w-full rounded-xl bg-white/5 border border-white/15 px-4 py-3.5 text-ink placeholder-ink-faint focus:border-brand focus:ring-2 focus:ring-[var(--ring)] outline-none transition" />
        <p id="cf-phone-err" class="cf-field-err" aria-live="polite"></p>
      </div>

      <div class="cf-field">
        <label for="cf-requirement" class="cf-label">What do you need?</label>
        <textarea id="cf-requirement" name="requirement" rows="5" minlength="5" placeholder="Tell us about the project (at least 5 characters)" required
          aria-describedby="cf-requirement-err"
          class="cf-input w-full rounded-xl bg-white/5 border border-white/15 px-4 py-3.5 text-ink placeholder-ink-faint focus:border-brand focus:ring-2 focus:ring-[var(--ring)] outline-none transition"></textarea>
        <p id="cf-requirement-err" class="cf-field-err" aria-live="polite"></p>
      </div>

      <button type="submit" class="cf-submit w-full rounded-xl py-4 font-semibold text-white flex items-center justify-center gap-2 transition hover:-translate-y-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
          <path d="M16 2C8.268 2 2 8.268 2 16c0 2.49.65 4.826 1.787 6.854L2 30l7.336-1.756A13.94 13.94 0 0 0 16 30c7.732 0 14-6.268 14-14S23.732 2 16 2zm6.328 19.928c-.346-.173-2.047-1.01-2.364-1.125-.317-.116-.548-.173-.779.173-.23.347-.894 1.126-1.096 1.357-.202.23-.404.26-.75.086-.346-.174-1.46-.538-2.782-1.716-1.028-.916-1.722-2.047-1.924-2.393-.202-.347-.021-.534.152-.707.156-.155.346-.404.52-.606.173-.202.23-.347.346-.578.115-.23.058-.433-.029-.606-.086-.173-.779-1.878-1.068-2.572-.28-.674-.566-.583-.78-.594l-.664-.01c-.23 0-.606.086-.924.433-.317.347-1.212 1.184-1.212 2.887 0 1.703 1.241 3.349 1.414 3.58.173.23 2.44 3.724 5.913 5.224.827.356 1.47.568 1.974.728.829.263 1.583.226 2.179.137.664-.099 2.047-.837 2.335-1.645.288-.808.288-1.501.202-1.645-.086-.144-.317-.23-.663-.404z"/>
        </svg>
        Send via WhatsApp
      </button>
    </form>

    <!-- Shown after submit: the page must never look like nothing happened. -->
    <div id="cf-success" class="contact-card max-w-xl mx-auto rounded-3xl p-6 sm:p-8 text-center" hidden>
      <div class="cf-tick" aria-hidden="true">✓</div>
      <h3 id="cf-success-title" class="font-display text-2xl mt-3">We've opened WhatsApp</h3>
      <p id="cf-success-body" class="mt-2 text-ink-muted">
        Press send in WhatsApp to reach us. Your details are already typed in.
        We usually reply within a few hours on working days.
      </p>
      <!-- Only shown when the browser blocked the new tab: a real link, which no popup blocker stops. -->
      <a id="cf-open" class="btn-primary mt-5" href="#" target="_blank" rel="noopener noreferrer" hidden>Open WhatsApp</a>
      <p class="mt-5 text-sm text-ink-faint">Nothing opened, or don't use WhatsApp?</p>
      <div class="cf-fallbacks">
        <button type="button" id="cf-copy" class="btn-glass">Copy my message</button>
        <a id="cf-mail" class="btn-glass" href={`mailto:${EMAIL}`}>Email it instead</a>
      </div>
      <p id="cf-copy-status" class="cf-copy-status" aria-live="polite"></p>
      <button type="button" id="cf-reset" class="cf-reset">Send another message</button>
    </div>
  </div>
</section>

<style>
  .contact-card {
    background: rgba(9, 13, 24, 0.82);
    border: 1px solid var(--line);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .cf-field { margin-bottom: 0.35rem; }
  .cf-field + .cf-field { margin-top: 1rem; }
  .cf-note { margin: 0 0 1rem; font-size: 0.8rem; color: var(--ink-faint); }
  .cf-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .cf-input[aria-invalid="true"] {
    border-color: #f87171;
  }
  .cf-field-err {
    font-size: 0.78rem;
    color: #fca5a5;
    margin: 0.35rem 0 0;
    min-height: 0;
  }
  .cf-field-err:empty { margin: 0; }

  .cf-submit {
    margin-top: 1.25rem;
    background: var(--whatsapp);
    box-shadow: 0 8px 30px rgba(11, 122, 104, 0.35);
  }
  .cf-submit:hover { box-shadow: 0 12px 36px rgba(11, 122, 104, 0.5); }

  .cf-tick {
    width: 3rem; height: 3rem;
    margin: 0 auto;
    display: grid; place-items: center;
    border-radius: 9999px;
    background: rgba(11, 122, 104, 0.2);
    border: 1px solid var(--whatsapp);
    color: #4ade80;
    font-size: 1.5rem;
  }
  .cf-fallbacks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .cf-copy-status {
    font-size: 0.8rem;
    color: var(--accent-cyan);
    min-height: 1rem;
    margin: 0.75rem 0 0;
  }
  .cf-reset {
    margin-top: 0.25rem; padding: 0.75rem 1rem; min-height: 44px;
    background: none;
    border: none;
    color: var(--ink-faint);
    font-size: 0.82rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .cf-reset:hover { color: var(--ink); }
</style>

<script>
  import { waLink, EMAIL } from "../data/site";

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const successPanel = document.getElementById("cf-success");
  const copyBtn = document.getElementById("cf-copy");
  const copyStatus = document.getElementById("cf-copy-status");
  const resetBtn = document.getElementById("cf-reset");
  const mailLink = document.getElementById("cf-mail") as HTMLAnchorElement | null;
  const openLink = document.getElementById("cf-open") as HTMLAnchorElement | null;
  const successTitle = document.getElementById("cf-success-title");
  const successBody = document.getElementById("cf-success-body");

  const FIELDS = ["name", "email", "phone", "requirement"] as const;

  const MESSAGES: Record<string, { missing: string; invalid: string }> = {
    name: { missing: "Please tell us your name.", invalid: "Please enter at least 2 characters." },
    email: { missing: "Please enter your email.", invalid: "That doesn't look like a valid email address." },
    phone: { missing: "Please enter your phone number.", invalid: "Please enter a valid phone number, e.g. +91 98765 43210." },
    requirement: { missing: "Please describe what you need.", invalid: "Please give us at least 5 characters." },
  };

  function fieldEl(name: string) {
    return document.getElementById(`cf-${name}`) as HTMLInputElement | HTMLTextAreaElement | null;
  }
  function errEl(name: string) {
    return document.getElementById(`cf-${name}-err`);
  }

  /** Validate one field with the browser's own constraint API. */
  function validateField(name: string): boolean {
    const el = fieldEl(name);
    const err = errEl(name);
    if (!el || !err) return true;

    const valid = el.checkValidity();
    if (valid) {
      el.removeAttribute("aria-invalid");
      err.textContent = "";
    } else {
      el.setAttribute("aria-invalid", "true");
      err.textContent = el.validity.valueMissing
        ? MESSAGES[name].missing
        : MESSAGES[name].invalid;
    }
    return valid;
  }

  // Clear an error as soon as the user fixes it, but don't nag while first typing.
  FIELDS.forEach((name) => {
    const el = fieldEl(name);
    el?.addEventListener("blur", () => validateField(name));
    el?.addEventListener("input", () => {
      if (el.getAttribute("aria-invalid") === "true") validateField(name);
    });
  });

  function buildMessage(): string {
    const value = (n: string) => fieldEl(n)?.value.trim() ?? "";
    return [
      "Hi TheArkTech! 👋 I found you on your website and would like to discuss a project.",
      "",
      `*Name:* ${value("name")}`,
      `*Email:* ${value("email")}`,
      `*Phone:* ${value("phone")}`,
      "",
      "*Requirement:*",
      value("requirement"),
    ].join("\n");
  }

  let lastMessage = "";

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    // Validate every field, then focus the first problem for keyboard users.
    const results = FIELDS.map((n) => ({ name: n, ok: validateField(n) }));
    const firstBad = results.find((r) => !r.ok);
    if (firstBad) {
      fieldEl(firstBad.name)?.focus();
      return;
    }

    lastMessage = buildMessage();
    const waUrl = waLink(lastMessage);

    // Open WhatsApp in a new tab and find out whether it actually opened. The
    // feature string deliberately omits `noopener`: with it, browsers return null
    // even on success, so a blocked popup would be indistinguishable from an
    // opened one. The opener link is cut by hand instead.
    let popup: Window | null = null;
    try { popup = window.open(waUrl, "_blank"); } catch { popup = null; }
    if (popup) { try { popup.opener = null; } catch { /* already severed */ } }
    const opened = popup !== null;

    if (mailLink) {
      mailLink.href =
        `mailto:${EMAIL}?subject=${encodeURIComponent("Project enquiry from thearktech.in")}` +
        `&body=${encodeURIComponent(lastMessage)}`;
    }

    // Tell the truth about what happened. If the browser blocked the tab, the
    // hand-off stays one click away as a plain link.
    if (openLink) { openLink.href = waUrl; openLink.hidden = opened; }
    if (successTitle) successTitle.textContent = opened ? "We've opened WhatsApp" : "Your message is ready";
    if (successBody) {
      successBody.textContent = opened
        ? "Press send in WhatsApp to reach us. Your details are already typed in. We usually reply within a few hours on working days."
        : "Your browser blocked the new tab. Open WhatsApp with the button below; your details are already typed in.";
    }

    // Swap the form for the confirmation so the page never looks inert.
    form.hidden = true;
    if (successPanel) {
      successPanel.hidden = false;
      successPanel.setAttribute("tabindex", "-1");
      // When blocked, land keyboard and screen-reader users on the one action that matters.
      (opened || !openLink ? successPanel : openLink).focus();
    }
  });

  copyBtn?.addEventListener("click", async () => {
    if (!copyStatus) return;
    try {
      await navigator.clipboard.writeText(lastMessage);
      copyStatus.textContent = "✓ Message copied — paste it to us on WhatsApp or email.";
    } catch {
      copyStatus.textContent = "Couldn't copy automatically — please use the email button.";
    }
  });

  resetBtn?.addEventListener("click", () => {
    if (!form) return;
    form.reset();
    FIELDS.forEach((n) => {
      fieldEl(n)?.removeAttribute("aria-invalid");
      const err = errEl(n);
      if (err) err.textContent = "";
    });
    if (successPanel) successPanel.hidden = true;
    if (openLink) openLink.hidden = true;
    if (copyStatus) copyStatus.textContent = "";
    form.hidden = false;
    fieldEl("name")?.focus();
  });
</script>
