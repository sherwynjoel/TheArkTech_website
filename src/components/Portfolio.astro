---
import { portfolioProjects, projectSlug } from "../data/portfolio.ts";
---

<section id="portfolio" class="portfolio-section section-y-lg overflow-hidden glow-anchor">
  <div class="container-x">
    <div class="portfolio-head reveal">
      <div>
        <p class="eyebrow mb-3">Portfolio</p>
        <h2 class="font-display text-[clamp(2rem,4vw,3.25rem)] leading-[1.05]">
          Recent builds with business impact
        </h2>
      </div>
      <p class="portfolio-intro">
        Real client engagements, each one live and visitable.
        <a href="/work" class="portfolio-intro-link">See all {portfolioProjects.length} projects →</a>
      </p>
    </div>

    <div class="portfolio-grid">
      {portfolioProjects.map((project, index) => (
        <article class="portfolio-card reveal" style={`transition-delay:${index * 70}ms`}>
          <div class="portfolio-media">
            {project.gallery ? (
              <div class="portfolio-gallery">
                {project.gallery.map((image, imageIndex) => (
                  <img
                    src={image}
                    alt={`${project.title} ${imageIndex === 0 ? "before" : "after"} screenshot`}
                    loading="lazy"
                    decoding="async"
                  />
                ))}
              </div>
            ) : (
              <img src={project.image} alt={`${project.title} project preview`} width="1280" height="800" loading="lazy" decoding="async" />
            )}
            <div class="portfolio-media-overlay"></div>
            <span class="portfolio-type">{project.type}</span>
          </div>

          <div class="portfolio-body">
            <div class="portfolio-kicker">{project.sector}</div>
            <h3 class="font-display">{project.title}</h3>
            <p>{project.summary}</p>

            <dl class="portfolio-metrics">
              {project.metrics.map((metric) => (
                <div>
                  <dt>{metric.value}</dt>
                  <dd>{metric.label}</dd>
                </div>
              ))}
            </dl>

            <div class="portfolio-bottom">
              <div class="portfolio-tags" aria-label={`${project.title} technologies and features`}>
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <a href={`/work/${projectSlug(project)}`} class="portfolio-link">
                Case study →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="portfolio-cta reveal">
      <p class="font-display">Have a project that should be here next?</p>
      <div class="portfolio-cta-actions">
        <a href="/work" class="btn-glass">Browse all work</a>
        <a href="#contact" class="btn-glass">Plan your build</a>
      </div>
    </div>
  </div>
</section>

<style>
  .portfolio-intro-link {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--brand-bright);
  }
  .portfolio-intro-link:hover { text-decoration: underline; text-underline-offset: 3px; }

  .portfolio-cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .portfolio-media img,
  .portfolio-gallery img {
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    filter: brightness(1.1) contrast(1.1);
  }

  .portfolio-section {
    position: relative;
    background:
      radial-gradient(36rem 28rem at 8% 8%, rgba(34, 211, 238, 0.08), transparent 62%),
      radial-gradient(32rem 28rem at 92% 72%, rgba(59, 130, 246, 0.12), transparent 64%);
  }

  .portfolio-head {
    display: grid;
    gap: 1.25rem;
    align-items: end;
    margin-bottom: clamp(2.25rem, 5vw, 4rem);
  }

  .portfolio-intro {
    max-width: 34rem;
    color: var(--ink-muted);
    line-height: 1.65;
  }

  .portfolio-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.35rem);
  }

  .portfolio-card {
    overflow: hidden;
    border-radius: 1.5rem;
    background: rgba(10, 14, 26, 0.72);
    border: 1px solid var(--line);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.45s ease,
      border-color 0.3s ease,
      background 0.3s ease;
  }

  .portfolio-card:hover {
    transform: translateY(-5px);
    border-color: rgba(96, 165, 250, 0.44);
    background: rgba(13, 20, 38, 0.86);
  }

  .portfolio-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-elev);
  }
  .portfolio-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .portfolio-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    height: 100%;
    padding: 0.5rem;
    background: rgba(0, 0, 0, 0.28);
  }

  .portfolio-gallery img {
    border-radius: 0.85rem;
    object-fit: contain;
    background: #05080d;
  }

  .portfolio-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.65s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .portfolio-card:hover .portfolio-media > img { transform: scale(1.06); }
  .portfolio-card:hover .portfolio-gallery img { transform: scale(1.03); }

  .portfolio-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.58));
  }

  .portfolio-type {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    border-radius: 9999px;
    padding: 0.4rem 0.8rem;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .portfolio-body {
    padding: clamp(1.25rem, 2.5vw, 1.65rem);
  }

  .portfolio-kicker {
    margin-bottom: 0.45rem;
    color: var(--brand-bright);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .portfolio-body h3 {
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    line-height: 1.15;
  }

  .portfolio-body p {
    margin-top: 0.75rem;
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .portfolio-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.25rem 0 0;
  }

  .portfolio-metrics div {
    padding: 0.85rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.09);
  }

  .portfolio-metrics dt {
    color: var(--ink);
    font-family: "Clash Display", sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .portfolio-metrics dd {
    margin: 0.15rem 0 0;
    color: var(--ink-faint);
    font-size: 0.78rem;
  }

  .portfolio-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-top: 1.1rem;
  }

  .portfolio-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .portfolio-link {
    width: fit-content;
    color: var(--ink);
    font-size: 0.82rem;
    font-weight: 700;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .portfolio-link:hover {
    color: var(--brand-bright);
    transform: translateX(3px);
  }

  .portfolio-tags span {
    border-radius: 9999px;
    padding: 0.32rem 0.7rem;
    background: rgba(59, 130, 246, 0.09);
    border: 1px solid rgba(59, 130, 246, 0.18);
    color: var(--brand-bright);
    font-size: 0.75rem;
  }

  .portfolio-cta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
    border-top: 1px solid var(--hairline);
  }

  .portfolio-cta p {
    font-size: clamp(1.45rem, 3vw, 2rem);
  }

  @media (min-width: 768px) {
    .portfolio-head {
      grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.7fr);
    }

    .portfolio-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .portfolio-cta {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  @media (min-width: 1180px) {
    .portfolio-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-card,
    .portfolio-media img {
      transition: none;
    }
  }
</style>


