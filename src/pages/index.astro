---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Nav from "../components/Nav.astro";
import LoadingScreen from "../components/LoadingScreen.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import Cursor from "../components/Cursor.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Services from "../components/Services.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import Industries from "../components/Industries.astro";
import Portfolio from "../components/Portfolio.astro";
import TechMarquee from "../components/TechMarquee.astro";
import ServiceQuiz from "../components/ServiceQuiz.astro";
import ConsultationBooking from "../components/ConsultationBooking.astro";
import FAQ from "../components/FAQ.astro";
import Contact from "../components/Contact.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CallFab from "../components/CallFab.astro";
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Confirm JS before opting into hide-then-reveal motion, so content is never gated
         on a class that a failed/absent script would leave un-set (blank sections). -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="icon" type="image/png" href="/logo.png" />
    <SEO
      title="TheArkTech | Software Development Company in Coimbatore"
      description="TheArkTech is a software development company in Coimbatore building web and mobile applications, custom software, cloud infrastructure, and AI automation."
      url="https://thearktech.in/"
      image="https://thearktech.in/banner.png"
      siteName="TheArkTech"
      keywords={[
        "software development company Coimbatore",
        "custom software development Coimbatore",
        "mobile app development company Coimbatore",
        "web application development Tamil Nadu",
        "IT services company in Coimbatore",
        "cloud and devops services India",
        "AI automation company Coimbatore"
      ]}
    />
  </head>
  <body class="bg-bg text-ink">
    <a href="#main" class="skip-link">Skip to content</a>
    <LoadingScreen />
    <ScrollProgress />
    <Cursor />
    <Nav />
    <main id="main" tabindex="-1">
      <Hero />
      <TrustStrip />
      <Services />
      <hr class="section-rule" aria-hidden="true" />
      <ServiceQuiz />
      <WhyChooseUs />
      <Industries />
      <hr class="section-rule" aria-hidden="true" />
      <Portfolio />
      <TechMarquee />
      <FAQ />
      <hr class="section-rule" aria-hidden="true" />
      <ConsultationBooking />
      <Contact />
    </main>
    <SiteFooter />
    <CallFab />

    <script>
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add("is-in"); obs.unobserve(e.target); }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll(".reveal").forEach((el) => obs.observe(el));
    </script>
  </body>
</html>
