---
import "../../styles/global.css";
import Nav from "../../components/Nav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SEO from "../../components/SEO.astro";
import CallFab from "../../components/CallFab.astro";
import { portfolioProjects, projectSlug } from "../../data/portfolio.ts";
import { COMPANY_NAME } from "../../data/site";

const liveCount = portfolioProjects.filter((p) => p.url).length;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `Work — ${COMPANY_NAME}`,
  url: "https://thearktech.in/work",
  hasPart: portfolioProjects.map((p) => ({
    "@type": "CreativeWork",
    name: p.title,
    url: `https://thearktech.in/work/${projectSlug(p)}`,
    about: p.sector,
  })),
};
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <SEO
      title={`Work — ${portfolioProjects.length} client projects | ${COMPANY_NAME}`}
      description={`Case studies from ${COMPANY_NAME}: ${portfolioProjects.length} client projects across e-commerce, healthcare, manufacturing and media — ${liveCount} of them live and visitable today.`}
      url="https://thearktech.in/work"
      image="https://thearktech.in/banner.png"
      siteName={COMPANY_NAME}
      keywords={["software development case studies", "web development portfolio Coimbatore"]}
    />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="bg-bg text-ink">
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />

    <main id="main" tabindex="-1" class="work glow-anchor">
      <div class="container-x">
        <header class="work-head">
          <p class="eyebrow mb-3">Work</p>
          <h1 class="font-display work-title">
            {portfolioProjects.length} projects.<br />
            <span class="text-brand-bright">{liveCount} you can visit right now.</span>
          </h1>
          <p class="work-lede">
            Every project below is a real client engagement, and each one links to the
            live site — check the work yourself rather than taking our word for it.
          </p>
        </header>

        <div class="work-grid">
          {portfolioProjects.map((p, i) => (
            <a href={`/work/${projectSlug(p)}`} class="work-card reveal" style={`transition-delay:${i * 60}ms`}>
              <div class="work-media">
                <img src={p.image} alt={`${p.title} — ${p.type}`} width="1280" height="800" loading="lazy" decoding="async" />
                <span class="work-type">{p.type}</span>
              </div>
              <div class="work-body">
                <span class="work-sector">{p.sector}</span>
                <h2 class="font-display work-name">{p.title}</h2>
                <p class="work-sum">{p.summary}</p>
                <span class="work-more">Read the case study →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </main>

    <SiteFooter />
    <CallFab />

    <script>
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add("is-in"); obs.unobserve(e.target); }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll(".reveal").forEach((el) => obs.observe(el));
    </script>
  </body>
</html>

<style>
  .work { padding: 7.5rem 0 5rem; }
  .work-head { max-width: 44rem; margin-bottom: 3.5rem; }
  .work-title { font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1.05; margin: 0; }
  .work-lede { margin-top: 1.1rem; color: var(--ink-muted); line-height: 1.75; }

  .work-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }

  .work-card {
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    transition: transform var(--dur-2) var(--ease-out-quart), border-color var(--dur-2) var(--ease-out-quart);
  }
  .work-card:hover { transform: translateY(-4px); border-color: var(--line-brand); }

  .work-media { position: relative; }
  .work-media img { width: 100%; height: 12rem; object-fit: cover; object-position: top; }
  .work-type {
    position: absolute; left: 0.85rem; bottom: 0.85rem;
    font-size: 0.72rem; padding: 4px 11px; border-radius: 9999px;
    background: rgba(0, 0, 0, 0.65); border: 1px solid var(--line);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
  }

  .work-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.45rem; flex: 1; }
  .work-sector { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint); }
  .work-name { font-size: 1.2rem; margin: 0; }
  .work-sum { font-size: 0.88rem; line-height: 1.65; color: var(--ink-muted); margin: 0; flex: 1; }
  .work-more { font-size: 0.85rem; color: var(--brand-bright); margin-top: 0.5rem; }
  .work-card:hover .work-more { text-decoration: underline; text-underline-offset: 3px; }
</style>
